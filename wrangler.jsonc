{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fancy-grass-9dae",
  "compatibility_date": "2026-08-24",
  "main": "./.output/server/index.mjs",
  "assets": {
    "directory": "./.output/public",
    "binding": "ASSETS"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false
    }
  },
  "keep_vars": true
}
